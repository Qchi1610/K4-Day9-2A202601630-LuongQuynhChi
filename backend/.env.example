# Application Configuration
APP_NAME="Electric Motorcycle AI Onboarding Assistant"
ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="change-this-in-production-super-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
PROMPT_INJECTION_PROTECTION=true

# Database (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="onboarding_db"

# LLM Configuration
# Note: MODEL_NAME is declared in source code (<= 10B parameters limit) and metadata.json, NOT in .env
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Alternative Provider Settings
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OLLAMA_BASE_URL="http://localhost:11434"

# Vector Database & Embeddings
# Supported stores: "faiss", "qdrant", "pinecone"
VECTOR_DB="faiss"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
FAISS_INDEX_PATH="./data/faiss_index"

# Confidence Thresholds
TROUBLESHOOTING_CONFIDENCE_THRESHOLD=0.70
